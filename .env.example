# Copier en .env puis remplir.
#
# Clé Google Cloud avec l'API « Street View Static API » activée.
# Sans elle, GeoFinder tourne en MODE DÉMO : les panoramas sont générés
# localement, le pipeline complet fonctionne mais les positions retournées
# ne correspondent à rien de réel.
GOOGLE_MAPS_API_KEY=

# Collecte (valeurs par défaut de l'UI, surchargeables par requête)
GEOFINDER_MAX_PANOS=250
GEOFINDER_SPACING_M=120
GEOFINDER_SV_SIZE=512x512
GEOFINDER_SV_FOV=90
GEOFINDER_WORKERS=8

# Recherche : poids du score CLIP face à la vérification géométrique ORB
GEOFINDER_CLIP_WEIGHT=0.75
GEOFINDER_RERANK=40
