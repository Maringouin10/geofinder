# Copier en .env puis remplir. Aucune variable n'est obligatoire :
# sans clé, GeoFinder utilise KartaView, qui n'en demande pas.

# --- Source d'images ---------------------------------------------------- #
# auto | mapillary | kartaview | google | demo
# « auto » prend la première source utilisable, dans cet ordre :
#   mapillary → kartaview → google → demo
GEOFINDER_PROVIDER=auto

# Mapillary : RECOMMANDÉ. Jeton gratuit et immédiat sur mapillary.com
# (Developers → Register application → Client token, format « MLY|... »).
# Meilleure couverture disponible sans compte payant.
MAPILLARY_ACCESS_TOKEN=

# Google Street View Static : nécessite un compte de facturation Google Cloud.
GOOGLE_MAPS_API_KEY=

# --- Collecte ----------------------------------------------------------- #
GEOFINDER_MAX_PANOS=250
GEOFINDER_SPACING_M=120
GEOFINDER_SV_SIZE=512x512
GEOFINDER_SV_FOV=90
GEOFINDER_WORKERS=8
# Une source injoignable doit échouer vite, pas figer le job.
GEOFINDER_DISCOVERY_TIMEOUT=12     # timeout par requête de découverte (s)
GEOFINDER_DOWNLOAD_TIMEOUT=30      # timeout par image téléchargée (s)
GEOFINDER_DISCOVERY_BUDGET=300     # temps max de la phase de recherche (s)
GEOFINDER_LOG_LEVEL=INFO           # DEBUG pour tout voir dans docker logs

# --- Recherche ---------------------------------------------------------- #
GEOFINDER_CLIP_WEIGHT=0.75
GEOFINDER_RERANK=40
